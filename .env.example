OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.1
# Optional for reasoning models (gpt-5.x, o-series): none | minimal | low | medium | high. Unset = model default.
# Higher effort can improve answers but is slower (Vercel function limit: maxDuration in vercel.json).
OPENAI_REASONING_EFFORT=
# Layer 3 reviewer model. Unset = same as OPENAI_MODEL (recommended; gpt-4o-mini failed the reviewer self-test).
REVIEW_MODEL=
REVIEW_ENABLED=true
PORT=3000
DATA_DIR=./Data
# First month of the financial year (4 = April). WACD: FY2027 = Apr 2026 - Mar 2027.
FY_START_MONTH=4
# Balance-sheet / trial-balance movements at or above this amount (EUR) are flagged as material.
MATERIALITY_EUR=50000

# ── ngrok whitelist ───────────────────────────────────────────────────────────
# Set to true to require all non-localhost requests to arrive via an ngrok tunnel.
NGROK_ENABLED=false
# Optional: comma-separated list of specific ngrok hostnames to allow.
# Leave blank to accept any ngrok hostname.
# Example: NGROK_ALLOWED_HOSTS=abc123.ngrok-free.app,xyz.ngrok.io
NGROK_ALLOWED_HOSTS=
